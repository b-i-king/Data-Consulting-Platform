# Backend environment variables. Copy to `.env` for local development.
# NEVER commit the real `.env` file — it holds secrets.

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Leave empty to use the in-memory store while developing.
DATABASE_URL=

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Passwords through Supabase Auth (api/services/auth.py).
# Supabase -> Project Settings -> API: "Project URL" and the anon / publishable key
# (NOT the service_role / secret key). Leave both empty to keep password hashes
# in the API itself (fine for local development).
SUPABASE_URL=
SUPABASE_KEY=

# Websites allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# Your scheduling links (Cal.com). BOOKING_URL = the FREE 30-minute consultation;
# PAID_BOOKING_URL = paid sessions, shown once you confirm a client's free call
# happened (empty = keep showing BOOKING_URL). See docs/RUN_THROUGH.md.
BOOKING_URL=https://cal.com/your-name/free-consultation
PAID_BOOKING_URL=
# Cal.com webhook secret (Settings -> Developer -> Webhooks). Lets Cal.com tell the
# app about bookings, reschedules, cancellations and ended meetings. Empty = off.
CALCOM_WEBHOOK_SECRET=

# Consulting after the free 30-minute first consultation (US dollars per hour).
CONSULTING_RATE_PER_HOUR_USD=80

# Stripe (docs/PAYMENTS.md). Empty = test mode: plans switch on with no charge.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Your website's address, for Stripe's "back to the site" links.
SITE_URL=http://localhost:3000

# Admins (comma-separated emails; normally just yours). An admin is also a
# consultant, and the FIRST one is the default consultant that "do it for me"
# clients go to when they pick nobody. Everyone else becomes a consultant by
# asking at sign-up and being approved in the workspace's Admin panel.
ADMIN_EMAILS=

# Runtime-based pricing for automated data cleaning.
PRICE_PER_RUNTIME_MINUTE_USD=0.50
BILLING_INCREMENT_SECONDS=60
MINIMUM_CHARGE_USD=0

# Fair use: most downloads one client account can make per window (0 = no limit).
DAILY_DOWNLOAD_LIMIT=20
DOWNLOAD_WINDOW_HOURS=24

# Optional big-data engine (PySpark). Off by default; needs
# `pip install -r requirements-spark.txt` and Java 17 (see docs/SPARK.md).
SPARK_ENABLED=false
SPARK_MASTER=local[*]
SPARK_APP_NAME=data-consulting-platform
SPARK_MIN_CELLS=50000000

# Upload limits.
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=20
MAX_DECOMPRESSED_MB=200
# Rows shown in the on-screen preview (the download always has every row).
PREVIEW_MAX_ROWS=5

# Integrations (Settings -> Integrations -> Supabase database): leave this OFF.
# true lets a client's database be on a private / local address — only for
# testing against a database on this machine.
ALLOW_PRIVATE_DB_HOSTS=

# "Connect" buttons (Settings -> Integrations), docs/CONNECTORS.md. One pair per
# tool, from its developer site; leave a pair empty to hide that button.
# Redirect URI to register everywhere: <API address>/api/connections/oauth/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox (development keys, Intuit's test company) or production
QUICKBOOKS_ENVIRONMENT=sandbox
# QuickBooks free Builder tier: 500,000 read calls a MONTH for the whole app
# (everyone is blocked past it). The app stops at 90%, gives each company a
# daily share, and allows 15 companies (15 x 1,000 x 30 = 450,000).
QUICKBOOKS_MAX_CONNECTIONS=15
QUICKBOOKS_DAILY_CALL_LIMIT=1000
QUICKBOOKS_MONTHLY_CALL_LIMIT=500000
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Xero plan limits (free Starter: 5 organizations, 1,000 calls/day each). The
# app refuses a 6th connection and stops at 90% of the daily limit.
XERO_MAX_CONNECTIONS=5
XERO_DAILY_CALL_LIMIT=1000
# Optional: "Sign in with Supabase" (clients can always paste a connection string)
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# This API's public address. Not needed on Render (it sets RENDER_EXTERNAL_URL).
PUBLIC_API_URL=
