# Backend environment variables. Copy to `.env` for local development.
# NEVER commit the real `.env` file — it holds secrets.

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Leave empty to use the in-memory store while developing.
DATABASE_URL=

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Websites allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# Your scheduling link (Calendly, Cal.com, ...).
BOOKING_URL=https://calendly.com/your-link

# Consulting after the free 30-minute first consultation (US dollars per hour).
CONSULTING_RATE_PER_HOUR_USD=80

# Stripe (docs/PAYMENTS.md). Empty = test mode: plans switch on with no charge.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Your website's address, for Stripe's "back to the site" links.
SITE_URL=http://localhost:3000

# Consultants (comma-separated emails; the FIRST is the default consultant that
# "do it for me" clients are assigned to) and the secret code they must enter
# to sign in. Leave the code empty to switch consultant sign-in off.
CONSULTANT_EMAILS=
CONSULTANT_ACCESS_CODE=

# Runtime-based pricing for automated data cleaning.
PRICE_PER_RUNTIME_MINUTE_USD=0.50
BILLING_INCREMENT_SECONDS=60
MINIMUM_CHARGE_USD=0

# Fair use: most downloads one client account can make per window (0 = no limit).
DAILY_DOWNLOAD_LIMIT=20
DOWNLOAD_WINDOW_HOURS=24

# Optional big-data engine (PySpark). Off by default; needs
# `pip install -r requirements-spark.txt` and Java 17 (see docs/SPARK.md).
SPARK_ENABLED=false
SPARK_MASTER=local[*]
SPARK_APP_NAME=data-consulting-platform
SPARK_MIN_CELLS=50000000

# Upload limits.
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=20
MAX_DECOMPRESSED_MB=200
# Rows shown in the on-screen preview (the download always has every row).
PREVIEW_MAX_ROWS=5
