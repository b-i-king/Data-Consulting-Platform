# Copy to .env.local for local development (never commit .env.local).

# Where the FastAPI backend runs. Local default shown; in Vercel set this to
# your Render URL, e.g. https://data-consulting-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Your scheduling link (fallback if the API is unreachable).
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-link

# Brand name shown in the header and page titles.
NEXT_PUBLIC_SITE_NAME=Data Consulting Platform

# Search engines (lib/seo.ts). Your public address — used for the sitemap,
# link previews and Google. Set it in Vercel once you have your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Search Console -> Add property -> "HTML tag" -> copy only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
